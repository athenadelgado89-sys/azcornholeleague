{
  "name": "Arizona Cornhole League",
  "short_name": "AZCL",
  "description": "Arizona cornhole clubs, events, vendors, players and the State Region Events season, in one place.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#13265C",
  "theme_color": "#0E1D49",
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "AZ Events", "url": "/#events", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Clubs", "url": "/#clubs", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Players", "url": "/#players", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
